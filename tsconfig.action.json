{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": [ "ESNext" ],
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": false,
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "types": ["node"]
  },
  "include": ["src"]
}
